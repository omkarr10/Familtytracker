<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_emergency"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_will_receive"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- SOS Button Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Pulsing SOS Circle -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp">

            <!-- Outer pulse ring -->
            <View
                android:id="@+id/sosPulseOuter"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/circle_sos_pulse"
                android:alpha="0.3" />

            <!-- Inner pulse ring -->
            <View
                android:id="@+id/sosPulseInner"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_sos_pulse"
                android:alpha="0.5" />

            <!-- Main SOS Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSOS"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:text="@string/sos_button"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/error"
                app:cornerRadius="70dp"
                app:elevation="8dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hold_for_sos"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- Emergency Contacts Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        android:layout_margin="12dp"
        android:layout_marginTop="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/emergency_contacts"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddContact"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/add_contact"
                    android:textSize="12sp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:icon="@drawable/ic_add"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Contact List -->
            <LinearLayout
                android:id="@+id/contactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tvNoContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_contacts"
                    android:textSize="14sp"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:padding="24dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
